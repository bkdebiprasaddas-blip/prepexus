# ==========================================================
#  Deny all HTTP access to this directory.
#  database/ holds the SQL dump, which contains user rows and
#  password hashes. It must never be downloadable over HTTP.
# ==========================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
