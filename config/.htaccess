# ==========================================================
#  Deny all HTTP access to this directory.
#  config/ holds database credentials. It must be included by
#  PHP on the filesystem, never requested over HTTP.
#  (Filesystem includes are unaffected by this rule.)
# ==========================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
