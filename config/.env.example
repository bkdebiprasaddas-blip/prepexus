# ==========================================================
#  Copy this file to "config/.env" and fill in real values.
#  ".env" is already listed in .gitignore, so it stays untracked.
#  config/.htaccess blocks HTTP access to this directory, so
#  these values are never reachable from a browser.
# ==========================================================

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=prepexus
